# 服务监听端口（nginx 反代到这里）
PORT=8787

# SQLite 数据库文件路径
# 本地开发用相对路径即可；生产环境强烈建议**绝对路径，放在 API 目录之外**，
# 避免重新部署 API 时（删目录 → 上传新包）误删数据库。
# 例：DB_PATH=/www/wwwroot/musiczh-db/analytics.db
DB_PATH=./analytics.db

# 管理员账号 seed（首次启动时写入 admins 表，后续修改需直接改库或加 API）
ADMIN_USERNAME=admin
# bcrypt 哈希；生成命令：node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$replace_this_with_real_bcrypt_hash

# JWT 签名密钥（任意长字符串，建议 64+ 位随机串）
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars

# 数据保留天数（events 与 failures 表）
RETENTION_DAYS=365

# CORS 允许的源（生产为 https://sleepno.cn，本地开发可加多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
