{
  "name": "musiczh-server",
  "version": "0.4.12",
  "description": "拾音运营后台 - 后端 API（Hono + SQLite）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "overview:backfill": "tsx src/scripts/backfillOverview.ts",
    "overview:status": "tsx src/scripts/setOverviewRollupStatus.ts",
    "test:overview": "tsx --test src/lib/overview/*.test.ts",
    "test:feature-flags": "tsx --test src/lib/featureFlags.test.ts src/routes/featureFlags.test.ts",
    "test:site-access": "tsx --test src/routes/siteAccess.test.ts",
    "test:cloudflare-origin": "tsx --test src/middleware/cloudflareOrigin.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.10",
    "jose": "^5.9.6",
    "tsx": "^4.19.2",
    "ua-parser-js": "^2.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/ua-parser-js": "^0.7.39",
    "typescript": "^5.9.0"
  }
}
